# =====================================================================
# CẤU HÌNH KẾT NỐI SUPABASE (DỰ ÁN: GIA ĐÌNH XANH - HOME SERVICE BOOKING)
# =====================================================================
# Hướng dẫn:
# 1. Mở Supabase Dashboard -> Project Settings -> API
# 2. Dán Project URL vào NEXT_PUBLIC_SUPABASE_URL
# 3. Dán anon public key vào NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. (Tùy chọn) Dán service_role secret key vào SUPABASE_SERVICE_ROLE_KEY
#    để hỗ trợ các thao tác quản trị (Admin KYC, Khóa tài khoản, Seed dữ liệu)
# 5. Chạy file SQL trong:
#    - 4. home_service_booking_supabase.sql
#    - supabase_rpc_functions.sql
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cổng chạy Web Server (Backend API + Frontend UI)
PORT=3000
